# ---------- PostgreSQL ----------
POSTGRES_DB=chickenwholesale
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ---------- Backend API ----------
# Full connection string used by the API container (built from the values above by default)
CONNECTION_STRING=Host=postgres;Port=5432;Database=chickenwholesale;Username=postgres;Password=change-me-strong-password
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-characters
JWT_ISSUER=ChickenWholesaleApi
JWT_AUDIENCE=ChickenWholesaleClient
JWT_EXPIRY_HOURS=12
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8081

# ---------- Frontend ----------
FRONTEND_PORT=8081
# Leave as /api when served behind the bundled nginx reverse proxy (docker compose default).
VITE_API_URL=/api
